# Cloudflare Pages 响应头配置
# 文档：https://developers.cloudflare.com/pages/configuration/headers/
# 注意：GitHub Pages 会忽略本文件；仅在 Cloudflare Pages 部署时生效

/*
  X-Content-Type-Options: nosniff
  # P2-24：X-Frame-Options 与 frame-ancestors 语义统一为「禁止嵌入」（原 SAMEORIGIN 与 none 冲突）
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # P2-24：CSP 资源策略统一在 index.html 的 <meta> 维护（GH Pages 也生效）；此处只保留 meta 无法表达的 frame-ancestors
  Content-Security-Policy: frame-ancestors 'none'
  # P2-24：补充 HSTS（仅 Cloudflare Pages 生效）
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Service Worker 必须不被长缓存，否则热更新会卡住
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 入口 HTML 每次回源验证（保证新版本即时生效）
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# 内容哈希命名的资源：一年 immutable（改内容即改文件名）
# 只有文件名里带内容哈希的才敢 immutable，否则改版后用户一年拿不到新版
/assets/app.*.css
  Cache-Control: public, max-age=31536000, immutable

# 未哈希的样式与模型：1 小时新鲜期 + 过期先给旧的再后台更新
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 第三方库：文件名含版本号的（three.r128）可长期缓存，其余短缓存
/vendor/three.r128.min.js
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 题库解析 Worker：不能长缓存，否则逻辑更新无法下发（SW 会另存一份）
/workers/*
  Cache-Control: public, max-age=0, must-revalidate

# 注意：不再写通用 /questions/* 规则（P2-2）。它与下面 *.json 规则同时命中会让
# Cloudflare 把两个 Cache-Control 用逗号合并，产生矛盾指令。题库统一走短缓存规则。

/knowledge.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

/case_library.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

# 图标与预览图
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800

# AI / 评分接口不缓存
/api/*
  Cache-Control: no-store

# 题库 JSON 唯一短缓存规则（P2-2：避免与通配规则冲突）：勘误后尽快生效；
# 离线由 Service Worker 的 DATA_CACHE 负责，不依赖 HTTP 缓存
/questions/*.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json; charset=utf-8

/questions/parts/*.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json; charset=utf-8
