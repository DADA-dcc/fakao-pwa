  "cards": [
    {
      "dot": "cyan",
      "title": "离线策略",
      "items": [
        "SW 预缓存核心外壳，HTML 命中后后台静默更新",
        "题库索引 Network-First(5s)，分块 JSON Cache-First 24h",
        "Wi-Fi/桌面下 PREFETCH_QUESTIONS 分批补齐；SW 自身不被长缓存"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI 与后端",
      "items": [
        "同源 /api/ai、/api/grade 由 Cloudflare Functions 持 Key 调 DeepSeek",
        "浏览器可回退为用户自带 Key 直连 api.deepseek.com",
        "Functions 用 KV（AI_RATE_LIMIT_KV）做限流"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与边界",
      "items": [
        "进度/错题/主题/Key 存 localStorage，大对象用 IndexedDB 兜底",
        "题库 9680 题按科目切块，首屏不拉整包",
        "CSP 仅允许 self 与 api.deepseek.com / api.github.com"
      ]
    }
  ]
